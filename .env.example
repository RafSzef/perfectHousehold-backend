# ==============================================================================
# Environment Configuration for PerfectHousehold Backend (Oracle VM / Production)
# ==============================================================================

# Application exposed port on the VM
APP_PORT=8080

# PostgreSQL Connection (separate container on Oracle VM)
# Option A: If using a shared Docker network -> use container name (e.g. postgres-db)
# Option B: If Postgres exposes port to host -> use Docker bridge gateway 172.17.0.1
DB_HOST=postgres
DB_PORT=5432
DB_NAME=perfecthousehold
DB_USER=postgres
DB_PASSWORD=change_this_postgres_password

# JWT Authentication Secret (HMAC-SHA256, 256-bit key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Docker network name where your existing PostgreSQL container lives (e.g. postgres-net)
POSTGRES_DOCKER_NETWORK=postgres-network
